# ==============================================================================
# TaskManager — environment configuration
# ==============================================================================
# Copy this file to `.env` before starting the stack:
#
#     cp .env.example .env
#     docker compose up --build
#
# ------------------------------------------------------------------------------
# SECURITY NOTICE
# ------------------------------------------------------------------------------
# Every secret below is a DEVELOPMENT PLACEHOLDER committed to source control so
# that the project runs with a single command, as the assignment requires.
#
# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET. If you change
# JWT_SECRET you MUST regenerate both keys, or PostgREST and GoTrue will reject
# every request. Regenerate with:
#
#     node scripts/generate-jwt-keys.js "<your-new-jwt-secret>"
#
# NEVER reuse these values outside local development.
# ==============================================================================


# ------------------------------------------------------------------------------
# Secrets
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD=postgres-dev-password
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Signed with JWT_SECRET above. role=anon / role=service_role.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIwODI1ODU2MDB9.6J2njt0Tqd8sZjZvJV9uYIPn4tKMdHB9n_Plq_i6oMI
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3NjcyMjU2MDAsImV4cCI6MjA4MjU4NTYwMH0.RDY4tRQ7CIO9gfaxuKf9ihX91F9-O0UlOS4NamGC7a4

# Supabase Studio dashboard basic-auth (enforced by Kong).
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase-dev-password

# Realtime cookie/session signing (must be >= 64 chars) and Vault encryption key
# (must be exactly 32 chars).
SECRET_KEY_BASE=super-secret-key-base-for-realtime-that-is-at-least-64-characters-long
VAULT_ENC_KEY=dev-vault-encryption-key-32chars


# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Host port for connecting with psql/TablePlus. Change if 5432 is taken locally.
POSTGRES_PORT_EXTERNAL=5432


# ------------------------------------------------------------------------------
# Kong API gateway — the single public entrypoint for all Supabase services
# ------------------------------------------------------------------------------
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


# ------------------------------------------------------------------------------
# PostgREST
# ------------------------------------------------------------------------------
PGRST_DB_SCHEMAS=public,storage,graphql_public
# Rows returned when the client does not specify a range. Acts as a hard ceiling
# on any single request, so a missing pagination bug cannot dump a whole table.
PGRST_DB_MAX_ROWS=1000


# ------------------------------------------------------------------------------
# GoTrue (Supabase Auth)
# ------------------------------------------------------------------------------
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

ENABLE_EMAIL_SIGNUP=true
# No SMTP server runs locally, so confirmation emails can never be delivered.
# Auto-confirming lets a reviewer register and log in immediately. This is a
# deliberate LOCAL-ONLY choice and is documented in the README assumptions.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Inbucket captures all outbound mail locally — nothing leaves the machine.
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@taskmanager.local
SMTP_SENDER_NAME=TaskManager
INBUCKET_PORT=9000


# ------------------------------------------------------------------------------
# Studio
# ------------------------------------------------------------------------------
STUDIO_PORT=3001
STUDIO_DEFAULT_ORGANIZATION=TaskManager
STUDIO_DEFAULT_PROJECT=TaskManager
SUPABASE_PUBLIC_URL=http://localhost:8000
IMGPROXY_ENABLE_WEBP_DETECTION=true


# ------------------------------------------------------------------------------
# Database seeding
# ------------------------------------------------------------------------------
# Set to false to start with an empty database (schema still applied).
SEED_DATABASE=true
SEED_USER_PASSWORD=Password123!


# ------------------------------------------------------------------------------
# Web application
# ------------------------------------------------------------------------------
# NOTE: Vite inlines VITE_* variables at BUILD time, so these are passed to the
# web image as build args in docker-compose.yml. Changing them requires a
# rebuild (`docker compose up --build`), not just a restart.
WEB_PORT=3000
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjIwODI1ODU2MDB9.6J2njt0Tqd8sZjZvJV9uYIPn4tKMdHB9n_Plq_i6oMI
