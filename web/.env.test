# Dummy values so unit/component tests can construct the Supabase client
# without a running stack. These are not secrets — no request in the unit or
# component test suite ever reaches a real network. Real credentials for
# integration tests come from the repository-root .env instead; see
# vitest.integration.config.ts.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=test-anon-key
